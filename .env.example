# =============================================================================
# Tommy Walid — environment variables
# Copy to .env.local (gitignored) and fill in real values. Never commit
# actual credentials — this file only documents which variables exist.
# =============================================================================

# --- Supabase (Market Insights — see src/lib/supabase/client.ts) -------------
# Project URL and anon (public, read-only) key from your Supabase project's
# Settings → API page. Server-only: intentionally NOT prefixed NEXT_PUBLIC_,
# since every read happens in a Server Component, never in the browser.
# Until both are set, the Market Insights page renders its existing empty
# state — the app runs fine without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- LP1 landing page lead form (see src/app/lp1/api/lead/route.ts) ----------
# URL of the Make custom webhook "Leads Belgique - Landing page". Server-only
# (NOT prefixed NEXT_PUBLIC_): the browser posts to /lp1/api/lead, which
# forwards to this URL. Until set, the endpoint returns an error and the form
# shows its error message — leads are never reported as sent.
LP1_LEAD_WEBHOOK_URL=

# --- LP1 Meta Pixel (see src/app/lp1/_lib/meta-pixel.ts) --------------------
# Public dataset/pixel ID from Meta Events Manager (not a secret). When set,
# LP1 shows the ad-measurement consent banner and loads the pixel only after
# "Accept". Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_META_PIXEL_ID=

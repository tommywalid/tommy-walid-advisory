# =============================================================================
# Tommy Walid — environment variables
# Copy to .env.local (gitignored) and fill in real values. Never commit
# actual credentials — this file only documents which variables exist.
# =============================================================================

# --- Supabase (Market Insights — see src/lib/supabase/client.ts) -------------
# Project URL and anon (public, read-only) key from your Supabase project's
# Settings → API page. Server-only: intentionally NOT prefixed NEXT_PUBLIC_,
# since every read happens in a Server Component, never in the browser.
# Until both are set, the Market Insights page renders its existing empty
# state — the app runs fine without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
